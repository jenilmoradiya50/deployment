# ========================================================
# Branch & ATM Work Tracker - Environment Configuration
# ========================================================

# Local Server Port (default: 5000)
PORT=5000

# Environment Mode (development | production)
NODE_ENV=production

# JWT Authentication Secret Key
JWT_SECRET=super-secret-branch-atm-sdwan-jwt-token-key-2026

# Default Initial Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# ========================================================
# CLOUD DATABASE (Recommended for Vercel Deployment)
# ========================================================
# Create a free cluster on MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# and paste your connection string below.
# If left blank, the app safely falls back to local JSON file storage!
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tracker?retryWrites=true&w=majority
